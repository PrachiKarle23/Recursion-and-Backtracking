class Solution {
public:
    char ans;
    void solve(string s,int k)
    {
        if(s.length()>=k){
            ans=s[k-1];
            return;
        }

        string ans="";
        for(int i=0;i<s.length();i++)
        {
            ans+=static_cast<char>(s[i]+1);
        }
        solve(s+ans,k);
    }
    char kthCharacter(int k) {
       string s="a";
       solve(s,k);
       return ans;
    }
};
