class Solution {
public:
    void solve(int i,int n,int k,vector<vector<int>>& ans,vector<int>a)
    {
        if(a.size()==k){
            ans.push_back(a);
            return;
        }
         
        for(int j=i;j<n+1;j++)
        {
           a.push_back(j);
           solve(j+1,n,k,ans,a);
           a.pop_back();
        }
    }
    vector<vector<int>> combine(int n, int k) {
       vector<vector<int>>ans;
       vector<int>a;
      
       solve(1,n,k,ans,a);
       return ans;
    }
};
